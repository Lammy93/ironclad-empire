{
  "schemaVersion": 1,
  "id": "minefortress",
  "version": "${version}",

  "name": "MineFortress Empires",
  "description": "MineFortress Empires: a continued fork of MineFortress, the Real-Time Strategy mod for Minecraft. Manage a group of pawns, to survive and grow your village. Original mod by remmintan.",
  "authors": [
    "remmintan",
    "MineFortress Empires contributors"
  ],
  "contact": {
    "homepage": "https://github.com/Lammy93/minefortress",
    "sources": "https://github.com/Lammy93/minefortress",
    "issues": "https://github.com/Lammy93/minefortress/issues"
  },

  "license": "MIT",
  "icon": "assets/minefortress/logo.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "org.minefortress.MineFortressMod"
    ],
    "client": [
      "org.minefortress.MineFortressClient"
    ],
    "server": [],
    "preLaunch": [
      "org.minefortress.earlyriser.MineFortressPreLaunch"
    ],
    "mm:early_risers": [
      "org.minefortress.earlyriser.GameModeEarlyRiser"
    ],
    "cardinal-components": [
      "org.minefortress.entity.components.ColonistBaritoneComponent",
      "org.minefortress.entity.components.WarriorPawnBaritoneComponent",
      "org.minefortress.entity.components.ArcherPawnBaritoneComponent"
    ]
  },
  "mixins": [
    "minefortress.mixins.json"
  ],
  "accessWidener" : "minefortress.accesswidener",
  "depends": {
    "fabricloader": ">=0.14.22",
    "fabric-api": ">=${fabric_api_min}",
    "fabric-transfer-api-v1": ">=0.91.6",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "mm": ">=2.3",
    "fabric-language-kotlin": ">=1.10.20+kotlin.1.9.24"
  },
  "recommends": {
    "keybind_fix": ">=1.0.0"
  },
  "suggests": {}
}
